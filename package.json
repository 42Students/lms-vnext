{
  "name": "lms-vnext",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "bootstrap:superadmin": "node --conditions=react-server ./node_modules/tsx/dist/cli.mjs scripts/bootstrap-superadmin.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:test:prepare": "tsx scripts/db-test-prepare.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "smoke:public": "node scripts/smoke-public.mjs",
    "db:e2e:prepare": "node --conditions=react-server ./node_modules/tsx/dist/cli.mjs scripts/db-e2e-prepare.ts",
    "test:load:reads": "tsx scripts/load-read.ts",
    "status": "tsx scripts/project-status.ts",
    "smoke:authenticated": "tsx scripts/smoke-authenticated.ts",
    "parity:status": "tsx scripts/parity-status.ts",
    "parity:pages": "tsx scripts/page-parity-status.ts",
    "parity:learner": "tsx scripts/learner-surface-status.ts",
    "parity:clone-gate": "tsx scripts/clone-parity-gate.ts",
    "db:parity:status": "node scripts/db-parity-tools.mjs status",
    "db:parity:inventory": "node scripts/db-parity-tools.mjs inventory",
    "db:parity:compare": "node scripts/db-parity-tools.mjs compare",
    "test:db:parity": "node --test tests/db-parity-tools.test.mjs tests/db-parity-contracts.test.mjs tests/db-parity-expanded-registry.test.mjs tests/db-parity-jpa-and-renames.test.mjs tests/db-parity-pass3.test.mjs tests/db-parity-pass4.test.mjs tests/db-parity-pass5.test.mjs tests/db-parity-db03-schema.test.mjs tests/db-parity-db09-tracker.test.mjs tests/db00-retirement-disposition.test.mjs tests/db06-reconciliation-contract.test.mjs",
    "test:db09:static": "node --test tests/db-parity-db09-tracker.test.mjs tests/db09-api-gates.test.mjs",
    "test:db09:pg": "vitest run --config vitest.db.config.ts tests/integration/db09-tpo-policy.test.ts tests/integration/db09-tpo-crm.test.ts",
    "db:journal:verify": "node scripts/verify-drizzle-journal.mjs",
    "db04:promotion:verify": "node scripts/verify-db04-promotion.mjs",
    "db01:promotion:verify": "node scripts/verify-db01-promotion.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "firebase-admin": "14.5.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.28.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vitest": "5.0.3",
    "tsx": "4.20.6"
  }
}
