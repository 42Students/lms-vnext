{
  "name": "lms-vnext",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "bootstrap:superadmin": "node --conditions=react-server ./node_modules/tsx/dist/cli.mjs scripts/bootstrap-superadmin.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:test:prepare": "tsx scripts/db-test-prepare.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "smoke:public": "node scripts/smoke-public.mjs",
    "db:e2e:prepare": "node --conditions=react-server ./node_modules/tsx/dist/cli.mjs scripts/db-e2e-prepare.ts",
    "test:load:reads": "tsx scripts/load-read.ts",
    "status": "tsx scripts/project-status.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "firebase-admin": "14.5.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.28.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vitest": "5.0.3",
    "tsx": "4.20.6"
  }
}
