# Local PostgreSQL or Cloud SQL Auth Proxy.
# Use DATABASE_URL locally. Do not combine it with the Unix-socket fields below.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms_vnext
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms_vnext_test
DB_POOL_MAX=5

# Cloud Run + Cloud SQL production-style connection.
# Leave DATABASE_URL unset when these are used.
# DB_PASSWORD should be injected from Secret Manager, not committed.
DB_USER=
DB_PASSWORD=
DB_NAME=lms_vnext
INSTANCE_UNIX_SOCKET=
GOOGLE_CLOUD_PROJECT=
GCP_REGION=
GCS_BUCKET=

# Cloud Run uses Application Default Credentials automatically.
# For local Google API access, prefer `gcloud auth application-default login`
# or Cloud SQL Auth Proxy instead of committing service-account JSON.
GOOGLE_APPLICATION_CREDENTIALS=

# Browser Identity Platform/Firebase values are public configuration, but
# NEXT_PUBLIC_* values are baked into the Next.js client bundle at build time.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
