# Local PostgreSQL or Cloud SQL Auth Proxy.
# Use DATABASE_URL locally. Do not combine it with the Unix-socket fields below.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms_vnext
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms_vnext_test
DB_POOL_MAX=5

# Cloud Run + Cloud SQL production-style connection.
# Leave DATABASE_URL unset when these are used.
# DB_PASSWORD should be injected from Secret Manager, not committed.
DB_USER=
DB_PASSWORD=
DB_NAME=lms_vnext
INSTANCE_UNIX_SOCKET=
GOOGLE_CLOUD_PROJECT=
GCP_REGION=
# Private R2 storage is optional for non-file pages, but every file operation
# requires ALL FOUR settings together; a missing/unsafe value fails closed (503).
# Supply secrets through the deployment secret store, not a committed env file.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
# Private bucket; must differ from the legacy public R2_BUCKET_NAME
R2_PRIVATE_BUCKET=

# Cloud Run uses Application Default Credentials automatically.
# For local Google API access, prefer `gcloud auth application-default login`
# or Cloud SQL Auth Proxy instead of committing service-account JSON.
GOOGLE_APPLICATION_CREDENTIALS=

# Browser Identity Platform/Firebase values are public configuration, but
# NEXT_PUBLIC_* values are baked into the Next.js client bundle at build time.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# DB-004 first-party verification service secrets. Both are at least 32
# characters, provisioned separately through Secret Manager and NEVER shared
# with general auth or committed to Git. No public issuance endpoint is
# enabled by merely setting these values. Authorized provider delivery and
# source-import approvals remain separate release gates.
AUTH_EMAIL_VERIFICATION_SECRET=
AUTH_EMAIL_VERIFICATION_KEY_VERSION=v1
AUTH_ROLE_PROOF_SECRET=
